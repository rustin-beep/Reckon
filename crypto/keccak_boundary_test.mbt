// keccak256 块边界回归向量。
//
// 期望摘要由独立实现（pycryptodome 的 Crypto.Hash.keccak）生成，专门覆盖
// rate=136 附近的边界（135/136/137）、多块（271/272/273、407/408/409、543/544/545）
// 以及若干随机长度。这是对 `keccak_test.mbt` 里 13 组基础向量的补充。

///|
fn pattern_bytes(n : Int32) -> Bytes {
  let out = FixedArray::make(n, b'\x00')
  for i in 0..<n {
    out[i] = ((i * 7 + 11) % 256).to_byte()
  }
  Bytes::from_array(out)
}

///|
test "keccak256 块边界与多块向量" {
  let cases : Array[(Int32, String)] = [
    (1, "60811857dd566889ff6255277d82526f2d9b3bbcb96076be22a5860765ac3d06"),
    (2, "1a7465acf22d8e3a382f76382110ee76bcdbe8bb18408f7561442e0916919a30"),
    (3, "1266684278052a8d32eca2a636e7b3fd8c55691d0428499ff607b5d6a878d5df"),
    (4, "35dfd81f7acbe4a440e087f13db4cd0edac47e595ebe0291217b4f8777b4cbd3"),
    (5, "a58ffb2cb9ac610ee122ad7fac9a80e4f58868630f576be0aade704d883e1896"),
    (10, "99826b0130ecc6c3a4ac918f8d6aee9a0dcce62d4347bf71085788618ddfbf84"),
    (55, "0c09f983eeee007de1d90925738ce0c05ef1e9debd06572b80ff1a94bc2ccb46"),
    (56, "291d90ea34eb23c05a67693845c9253d31d57a282ee69bd26ad706722bb27ef9"),
    (57, "dc765836b563c57bc921a883efb5786f6572e3275b44ba57efe02ca4e8dcf934"),
    (135, "47a414666f08a4658719043e5045638ef1ff99cb09400eff6289e6dc80c0970a"),
    (136, "91bac0515ccd2811f7b65984a2971e3d6093ccb9fac349b14c048499c2832e81"),
    (137, "2f6ff8190b36c8fb07cd335ea4f242fdca62380df126f23aba320b8e74be3d63"),
    (271, "67cd16d4b81d9371024e85c926ca78b79b5ff4447847f21f42678d7adc3a1c8b"),
    (272, "490d7f50c63ba285913a6e03deb33641fa06e0870a192f253c10fdc8e556e7c8"),
    (273, "161a3e5476db9cea1ef3cb16b5401f362d46c0f83011663915cd08f43e3e9fb4"),
    (407, "e6ea669df3f8f67628e5685b4c94dece70635bd80b115af31203f43770075626"),
    (408, "00038e0bd4649f321aa0616b2b27ef96c502eed97514cea89567bc49a62c0668"),
    (409, "09a29ff33b0b4c972a754d4dea1544e8f65c4f80cabb8c10f5abc91ade56a605"),
    (543, "68305b3dc03f6ad236e2d2858c74b347b03ae6ffb900aa49a361d3c3e4db1e9e"),
    (544, "537981189be31b9d2a805658b7fcd02dba3ec3d2c0b709ec524a452b233d40ee"),
    (545, "9bb1752993cb019729fb7cab80311713899d89b20d577f1198ddb64815c03312"),
    (17, "6094ac22595cc99badc678c6c32545ff9b1cdec4e5154f7d75902fe53667c77a"),
    (33, "82473904e0d1143406488073d74f82d9535b84a5e1340c55127cbeaaccca465f"),
    (64, "80cad99ac988c917d702885f317d49c6a95a4bb25490daa801e90f145d72567e"),
    (100, "9059da14dcbf39a07315369f2715bff9620a4c20b41a4f459ef1abf105c07676"),
    (128, "8beccf5b23d72f00ac7638b6f14e103fc85388b873520b3b087d66c57739f98e"),
    (200, "661797e2bc621e734e4486e9be37bf204aae0fa0d78ed3493dfcaa1f51698121"),
    (256, "ed0f085fd1f54102ba800ecf5a4b91990592efc287ce9c3fde784d9dd883ea2b"),
    (300, "6bb5f45c7de136620b928d7a8cdb07c32038adc023d6934a8ed91abc976375cf"),
    (400, "2071a07b34eb9e8bf5ce0db1bfb3a526b32d6502fdc934711b47b14baf7d9f65"),
    (500, "62e3dcd4a62741dfcf290ea8dd2b70ca3b2aea8fb4857bc8865863cb2e7594b6"),
  ]
  for c in cases {
    let (n, expected) = c
    assert_eq(
      @types.hex_encode(@crypto.keccak256(pattern_bytes(n)[:]).as_bytes()),
      expected,
    )
  }
}
